# RESTO-HUB — variables d'environnement locales
# Copier ce fichier vers `.env` : `cp .env.example .env` puis renseigner les valeurs.
# Aucun secret réel ne doit être versionné (voir CONTRIBUTING.md).

# ---- PostgreSQL (docker-compose) -------------------------------------------
RESTO_DB_PASSWORD=changez-moi-postgres
RESTO_APP_PASSWORD=changez-moi-app
RESTO_DB_NAME=resto_identity
RESTO_DB_PORT=5432

# ---- Redis -----------------------------------------------------------------
RESTO_REDIS_PASSWORD=changez-moi-redis
RESTO_REDIS_PORT=6379

# ---- MinIO (stockage objet compatible S3) -----------------------------------
MINIO_ROOT_USER=resto-minio
MINIO_ROOT_PASSWORD=changez-moi-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Services (développement local) ----------------------------------------
# Clé partagée pour les appels internes entre services (/internal/*).
INTERNAL_API_KEY=dev-interne-resto-hub
# Secret de signature des webhooks de paiement (valeurs de démonstration uniquement).
PAYMENT_WEBHOOK_SECRET=dev-webhook-resto-hub

# ---- Applications web (ports Vite ; 5176/5175 par défaut) ------------------
WEB_ORIGIN=http://localhost:5176
CLIENT_ORIGIN=http://localhost:5175
